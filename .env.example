# Copy to .env — never commit .env
# Obligatorio: la URI debe empezar por mongodb:// o mongodb+srv:// (sin espacio tras =)
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority&appName=MyCluster
MONGODB_DB_NAME=tienda_coleccionables
# Comma-separated origins, or * (restrict in production)
# CORS_ORIGINS=https://mi-app.com,http://localhost:5173
CORS_ORIGINS=*

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
